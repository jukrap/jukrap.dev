{
	"name": "jukrap.dev",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev --webpack --hostname 127.0.0.1",
		"generate-metadata": "ts-node scripts/generate-image-metadata.ts",
		"generate-graphic-fallbacks": "node scripts/generate-graphic-fallbacks.mjs",
		"build": "npm run generate-metadata && next build --webpack",
		"typecheck": "tsc --noEmit --incremental false",
		"format:check": "prettier --check .",
		"test:e2e": "npm run build && playwright test tests/e2e && npm run test:privacy-enabled",
		"test:visual": "npm run build && playwright test tests/visual --project=chromium",
		"start": "next start",
		"test:privacy-enabled": "playwright test --config=playwright.private-enabled.config.ts"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@react-three/fiber": "^9.6.1",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.40.0",
		"lucide-react": "^1.17.0",
		"next": "^16.2.7",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-modal": "^3.16.3",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"three": "^0.185.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.62.0",
		"@svgr/webpack": "^8.1.0",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
		"@types/react-modal": "^3.16.3",
		"@types/three": "^0.185.1",
		"postcss": "^8.5.15",
		"prettier": "^3.8.3",
		"sharp": "^0.35.3",
		"tailwindcss": "^3.4.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"postcss": "$postcss"
	}
}
