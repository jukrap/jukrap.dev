		"prebuild": "npm run check:public"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.40.0",
		"lucide-react": "^1.17.0",
		"next": "^16.4.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-modal": "^3.16.3",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"three": "^0.186.0",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
		"@types/react-modal": "^3.16.3",
		"@types/three": "^0.186.0",
		"postcss": "^8.5.32",
		"prettier": "^3.8.3",
