{
	"name": "jukrap.dev",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev --webpack --hostname 127.0.0.1",
		"generate-metadata": "ts-node scripts/generate-image-metadata.ts",
		"build": "npm run generate-metadata && next build --webpack",
		"start": "next start",
		"check:public": "node scripts/check-public-boundary.mjs",
		"check:staged": "node scripts/check-public-boundary.mjs --staged",
